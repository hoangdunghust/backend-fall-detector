# ===================== Ứng dụng =====================
PORT=3000
# Chạy sau reverse proxy (Nginx/Caddy/Cloudflare)? Đặt true để lấy đúng IP khi giới hạn tần suất đăng nhập
TRUST_PROXY=false
# Danh sách origin được phép gọi từ trình duyệt (phân tách bằng dấu phẩy). App di động không cần.
CORS_ORIGINS=

# ===================== Cơ sở dữ liệu (PostgreSQL) =====================
# --- Cách A (khuyến nghị): Supabase ---
# Supabase Dashboard -> nút "Connect" (hoặc Settings -> Database -> Connection string).
# Thay [ref], [password], [region]. Mật khẩu có ký tự đặc biệt phải URL-encode (@ -> %40, / -> %2F, # -> %23).
#
# DATABASE_URL: ứng dụng dùng. Transaction pooler, cổng 6543, BẮT BUỘC có ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Prisma CLI (migrate/db push) dùng. Session pooler (cổng 5432, chạy được trên IPv4)
# hoặc kết nối trực tiếp db.[ref].supabase.co:5432 (chỉ IPv6 nếu không mua add-on IPv4). KHÔNG dùng cổng 6543.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
#
# --- Cách B: Postgres cục bộ (docker compose --profile local-db up -d db) ---
# DATABASE_URL="postgresql://fall:fall_dev_password@localhost:5432/fall?schema=public"
# DIRECT_URL="postgresql://fall:fall_dev_password@localhost:5432/fall?schema=public"
# Mật khẩu dùng cho container db của docker-compose:
DB_PASSWORD=fall_dev_password

# ===================== Thiết bị ESP32 duy nhất =====================
# In ra Serial khi ESP khởi động: "Device ID: esp_xxxxxxxxxxxx"
DEVICE_ID=esp_a1b2c3d4e5f6

# ===================== MQTT broker =====================
# HiveMQ Cloud: mqtts://<host>:8883   |   Mosquitto cục bộ: mqtt://localhost:1883
MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# (tùy chọn) CA riêng nếu broker dùng chứng chỉ tự ký
MQTT_CA_PATH=
MQTT_CLIENT_ID=

# ===================== Đăng nhập (1 tài khoản cố định) =====================
AUTH_USERNAME=admin
# Tạo bằng:  npm run hash-password -- "mat-khau-cua-ban"
AUTH_PASSWORD_HASH_B64=
# Chuỗi ngẫu nhiên >= 32 ký tự (lệnh hash-password cũng in ra một chuỗi để dùng)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ===================== Thông báo đẩy =====================
# console: chỉ ghi log (mặc định)
# expo   : qua dịch vụ Expo Push (dùng với app Expo đi kèm; KHÔNG cần Firebase trong code app)
# fcm    : Firebase Cloud Messaging trực tiếp (chỉ khi app dùng token FCM)
NOTIFY_PROVIDER=console
# expo: access token (tùy chọn, chỉ cần nếu bạn bật "enhanced push security" trong dự án Expo)
EXPO_ACCESS_TOKEN=
# fcm: đường dẫn file service account HOẶC nội dung JSON (một trong hai)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ===================== Giám sát =====================
# Quá ngần này giây không có heartbeat => coi thiết bị offline (heartbeat 30s/lần)
HEARTBEAT_TIMEOUT_S=90
# Sóng yếu: CSQ <= giá trị này (hoặc 99) trong N heartbeat liên tiếp
WEAK_SIGNAL_CSQ=5
WEAK_SIGNAL_READINGS=3
# Nhắc lại cùng một cảnh báo sức khỏe sau ngần này phút nếu vẫn còn
ALERT_COOLDOWN_MIN=360
# Hai sự kiện cùng loại trong ngần này giây bị coi là trùng
DEDUPE_WINDOW_S=8

# ===================== Lưu trữ =====================
HEALTH_RETENTION_DAYS=30
LOCATION_RETENTION_DAYS=90

# (tùy chọn, cho `npm run seed`) số khẩn cấp ban đầu, cách nhau bởi dấu phẩy
SEED_CONTACTS=

# ===================== Tài liệu API (Swagger) =====================
# Mở tại http://localhost:3000/docs. Bỏ trống: BẬT khi chạy dev, TẮT khi NODE_ENV=production (Docker).
# Đặt true để bật cả trên server, false để tắt hẳn.
SWAGGER_ENABLED=
